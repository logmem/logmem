{
  "name": "@logmem/server",
  "version": "0.1.0",
  "private": true,
  "description": "LogMem server: shared memory for agent teams. Implements ACMI (compat mode via LOGMEM_ACMI_COMPAT=1).",
  "type": "module",
  "license": "UNLICENSED",
  "main": "src/server.mjs",
  "bin": {
    "logmem-mcp": "src/stdio/index.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/stdio/index.mjs",
    "test": "node --test test/*.test.mjs",
    "conformance": "node scripts/conformance.mjs",
    "spec": "node scripts/gen-spec.mjs",
    "spec:check": "node scripts/gen-spec.mjs --check",
    "migrate:dry-run": "node scripts/migrate-dry-run.mjs",
    "test:ops": "node --test test/ops*.test.mjs",
    "ci": "npm test && npm run spec:check && npm run conformance"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "2.7.0",
    "redis": "^4.7.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@madezmedia/acmi": "1.2.0"
  }
}
