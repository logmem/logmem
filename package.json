{
  "name": "@logmem/mcp",
  "version": "0.1.0",
  "description": "LogMem MCP server: shared memory for agent teams. Implements ACMI (compat mode via LOGMEM_ACMI_COMPAT=1).",
  "type": "module",
  "license": "MIT",
  "main": "src/server.mjs",
  "bin": {
    "logmem-mcp": "src/stdio/index.mjs"
  },
  "files": [
    "LICENSE",
    "server.json",
    "src/stdio/index.mjs",
    "src/server.mjs",
    "src/core/",
    "src/compat/acmi-tools.mjs",
    "src/lib/backend.mjs",
    "src/lib/helpers.mjs",
    "src/lib/lua-scripts.mjs",
    "src/lib/memory-redis.mjs",
    "src/lib/redis-native.mjs",
    "src/lib/redis-rest.mjs",
    "src/lib/redact.mjs",
    "src/http/log.mjs",
    "src/http/pin.mjs",
    "src/http/net-guard.mjs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://logmem.si",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madezmedia/logmem.git"
  },
  "bugs": {
    "url": "https://github.com/madezmedia/logmem/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/stdio/index.mjs",
    "test": "node --test test/*.test.mjs",
    "conformance": "node scripts/conformance.mjs",
    "spec": "node scripts/gen-spec.mjs",
    "spec:check": "node scripts/gen-spec.mjs --check",
    "plugin:sync": "node scripts/plugin-sync.mjs",
    "plugin:check": "node scripts/plugin-sync.mjs --check",
    "migrate:dry-run": "node scripts/migrate-dry-run.mjs",
    "test:ops": "node --test test/ops*.test.mjs",
    "ci": "npm test && npm run spec:check && npm run conformance",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "redis": "^6.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clerk/backend": "^3.26.0",
    "@madezmedia/acmi": "1.2.0",
    "@playwright/test": "1.64.1",
    "@vercel/blob": "2.8.2"
  },
  "mcpName": "si.logmem/mcp"
}
