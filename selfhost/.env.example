# LogMem self-host environment — copy to .env and fill in.
# install.sh generates a real .env (mode 600) for you; this file documents
# every name the bundle uses. Never commit a filled-in .env.

# ── Space ────────────────────────────────────────────────────────────────
# First space: LOGMEM_SPACE names it, LOGMEM_SPACES allows it.
LOGMEM_SPACES=main
LOGMEM_SPACE=main
LOGMEM_VIEW_SPACES=main

# ── Listener ─────────────────────────────────────────────────────────────
# The server binds SERVER_HOST inside the container; compose publishes
# 127.0.0.1:SERVER_PORT only. Redis is published 127.0.0.1:REDIS_PORT.
SERVER_HOST=0.0.0.0
SERVER_PORT=3899
REDIS_PORT=6399

# ── Your credentials (generate: openssl rand -hex 32) ────────────────────
# Admin password signs you into /keys and the web UI.
LOGMEM_ADMIN_PASSWORD=
# Signs decision receipts (jobs, asks, recaps).
LOGMEM_DECIDE_SECRET=
# Encrypts OAuth client secrets at rest.
LOGMEM_OAUTH_KEK=
# Authorizes cron runs: curl -H "Authorization: Bearer $CRON_SECRET" ...
CRON_SECRET=
# Redis password, required by the bundle's Redis container.
REDIS_PASSWORD=

# ── Local-only switches ──────────────────────────────────────────────────
# Allows plaintext redis:// on this machine (the bundle's own network).
# The designed local hatch. Never set it on a hosted deployment.
LOGMEM_OAUTH_ALLOW_INSECURE=1

# ── Optional ─────────────────────────────────────────────────────────────
# Clerk sign-in for customer-facing screens (the bundle works without it;
# admin-password sign-in covers the fleet UI). Leave unset for local only.
# CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=
