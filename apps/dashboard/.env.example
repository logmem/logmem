# apps/dashboard: every variable the dashboard reads. Copy to .env.local (dev)
# or add in the Vercel project settings (Preview). Never commit real values.

# Turns on the customer dashboard code path. Must be exactly 1.
LOGMEM_CUSTOMER_DASHBOARD=1

# Clerk. Dev and Preview use the DEVELOPMENT instance (pk_test_ and sk_test_).
# Production uses the production instance (pk_live_ and sk_live_) on logmem.si.
# The publishable key is public. The secret key is not.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Redis for customer spaces. Must start with rediss:// (TLS).
# Dev and Preview should point at a TEST Redis, not production data.
LOGMEM_CUSTOMER_REDIS_URI=

# Signs and checks decisions on Today (needed from N2). Use a different value
# per environment.
LOGMEM_DECIDE_SECRET=
