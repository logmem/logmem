# apps/dashboard: every variable the dashboard reads. Copy to .env.local (dev)
# or add in the Vercel project settings (Preview). Never commit real values.

# Turns on the customer dashboard code path. Must be exactly 1.
LOGMEM_CUSTOMER_DASHBOARD=1

# Clerk publishable and secret keys. The publishable key is public. The secret is not.
# Which Clerk instance this dashboard should use is not settled. Do not treat the
# Oct 26 dev-instance note, or a DNS add, as a production Clerk GO.
# Checked with GET on Nov 9, 2026 (HEAD /sign-in has returned 405, so it is not a check):
#   GET https://logmem.si/sign-in is 200. Its Content-Security-Policy allows
#   https://clerk.logmem.si, https://challenges.cloudflare.com, and
#   https://*.protect.clerk.com.
#   GET https://logmem.si/app is 200. Its Content-Security-Policy still allows
#   only https://*.accounts.dev, not clerk.logmem.si.
# Do not change DNS, credentials, or CSP from this file. Security settings need
# the owner's GO before any deploy.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Redis for customer spaces. Must start with rediss:// (TLS).
# Dev and Preview should point at a TEST Redis, not production data.
LOGMEM_CUSTOMER_REDIS_URI=

# Signs and checks decisions on Today (needed from N2). Use a different value
# per environment.
LOGMEM_DECIDE_SECRET=
