# Space this connection is bound to (stdio), and which spaces are allowed.
LOGMEM_SPACE=madez
LOGMEM_SPACES=madez

# Agent used for the automatic Start when nobody calls logmem_start.
LOGMEM_AGENT=
# Name shown in "agent (via surface)". Defaults to the MCP client's name.
LOGMEM_SURFACE=

# Expose acmi_* tools and read legacy acmi:* keys.
LOGMEM_ACMI_COMPAT=0

# Backend (first match wins). With none, stdio runs in memory (degraded).
LOGMEM_REDIS_URI=
LOGMEM_REST_URL=
LOGMEM_REST_TOKEN=

# HTTP deploy only: Redis for OAuth records, and the break-glass bearer.
# Official Redis over TLS (preferred), or an HTTP Redis REST bridge.
LOGMEM_DEPLOY_REDIS_URI=
LOGMEM_DEPLOY_REST_URL=
LOGMEM_DEPLOY_REST_TOKEN=
LOGMEM_DIRECT_AUTH_TOKEN=

# Managed accounts (one-click connect). Off unless LOGMEM_MANAGED=1.
LOGMEM_MANAGED=
LOGMEM_CUSTOMER_REDIS_URI=
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
# Set to 1 to let anyone sign up (unset during the invite-only beta).
LOGMEM_SIGNUP_OPEN=
